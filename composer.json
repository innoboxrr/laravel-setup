{
    "name": "innoboxrr/laravel-setup",
    "description": "Configuración de inicial de una aplicación de laravel",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\LaravelSetup\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\LaravelSetup\\Providers\\LaravelSetupServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "innoboxrr/larapack-generator": "^7.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\LaravelSetup\\Tests\\": "tests/"
        }
    }
}
