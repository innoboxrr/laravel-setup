{
    "name": "innoboxrr/laravel-setup",
    "description": "Convierte una aplicación Laravel 13 recién creada en la aplicación base del ecosistema innoboxrr: autenticación, sitio, administrador en Vue o React y el usuario generado con LaraPack.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\LaravelSetup\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "innoboxrr/larapack-generator": "^7.10",
        "laravel/framework": "^13.0"
    },
    "conflict": {
        "innoboxrr/larapack-generator": "<7.10.2"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\LaravelSetup\\Providers\\LaravelSetupServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\LaravelSetup\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
